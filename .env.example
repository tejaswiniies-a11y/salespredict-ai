PORT=5000
# Option 1 – Standard SRV (preferred when DNS supports it)
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/sales_prediction?retryWrites=true&w=majority&appName=Cluster0
# Option 2 – Direct shard connection (use on Windows / networks that block SRV lookups)
MONGODB_URI=mongodb://username:password@shard-00-00.xxxx.mongodb.net:27017,shard-00-01.xxxx.mongodb.net:27017,shard-00-02.xxxx.mongodb.net:27017/sales_prediction?ssl=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
PYTHON_PATH=python
